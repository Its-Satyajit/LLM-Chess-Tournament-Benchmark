{
  "name": "llm-chess-arena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"nub run dev:server\" \"nub run dev:web\"",
    "dev:server": "PORT=3001 nub watch packages/server/src/index.ts",
    "dev:web": "cd packages/web && nubx vite",
    "build": "nub run build:server && nub run build:web",
    "test": "cd packages/server && nubx vitest run && cd ../web && nubx vitest run",
    "lint": "nubx oxlint packages/*/src",
    "lint:fix": "nubx oxlint --fix packages/*/src",
    "typecheck": "cd packages/server && tsc --noEmit && cd ../web && tsc --noEmit",
    "start": "npx -y nub@0.7.5 packages/server/src/index.ts",
    "build:server": "cd packages/server && tsc",
    "build:web": "cd packages/web && nub exec vite build"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "*": true
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.25.0",
      "onFail": "warn"
    }
  }
}
