{
  "name": "llm-chess-arena",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.23.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"nub run dev:server\" \"nub run dev:web\"",
    "dev:server": "PORT=3001 nub watch packages/server/src/index.ts",
    "dev:web": "cd packages/web && nubx vite",
    "build": "cd packages/server && tsc && cd ../web && vite build",
    "test": "cd packages/server && nubx vitest run && cd ../web && nubx vitest run",
    "lint": "nubx oxlint packages/*/src",
    "lint:fix": "nubx oxlint --fix packages/*/src",
    "typecheck": "cd packages/server && tsc --noEmit && cd ../web && tsc --noEmit"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "*": true
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
