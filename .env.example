# LLM Chess Arena — Environment Variables
# Copy this file to .env and fill in the values.

# Server
NODE_ENV=development
PORT=3001

# Database (local SQLite path or Turso LibSQL URL)
# For local SQLite:
# DATABASE_URL=./data/db.sqlite
# For Turso LibSQL:
DATABASE_URL=libsql://llmarena-sonumahato0010.aws-ap-south-1.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# JWT (used for player authentication tokens)
JWT_SECRET=your-secret-key-here

# Logging
LOG_LEVEL=info
