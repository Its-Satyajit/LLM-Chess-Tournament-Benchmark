{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "server.ts",
    "src/app/**/page.tsx",
    "src/app/api/**/route.ts",
    "src/app/layout.tsx"
  ],
  "ignorePatterns": [
    "skills/**",
    "tools/**"
  ],
  "ignoreDependencies": [
    "better-sqlite3",
    "@oxlint/plugins"
  ],
  "rules": {
    "unused-class-members": "off"
  }
}
