// AI AGENTS: DO NOT MODIFY THIS FILE.
// This configuration is intentionally strict.
// Do not add, remove, weaken, downgrade, disable, or reorder rules.
// Do not change category severity from "error".
// Do not bypass a lint failure by weakening this configuration.
// If a rule causes a failure, fix the source code instead.
// Any change to this file requires explicit human approval.



{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],

  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },

  "rules": {
    "typescript/no-unused-vars": "error",
    "typescript/no-explicit-any": "error",

    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-includes": "error",

    "unicorn/no-null": "error",
    "unicorn/prefer-module": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-global-this": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-instanceof-builtins": "error",

    "unicorn/filename-case": "error",

    "react/react-in-jsx-scope": "error",
    "react/no-array-index-key": "error",
    "react/jsx-max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "react/no-unsafe": "error",
    "react/no-string-refs": "error",
    "react/prefer-function-component": "error",
    "react/jsx-key": "error",
    "react/no-multi-comp": "error",

    "eslint/no-magic-numbers": "error",
    "eslint/no-nested-ternary": "error",
    "eslint/no-ternary": "error",
    "eslint/no-eval": "error",
    "eslint/no-implied-eval": "error",
    "eslint/no-implicit-coercion": "error",
    "eslint/no-implicit-globals": "error",
    "eslint/no-inner-declarations": "error",
    "eslint/no-new": "error",
    "eslint/no-multi-assign": "error",
    "eslint/no-unreachable": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-negation": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-template": "error",
    "eslint/preserve-caught-error": "error",

    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },

  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],

  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "*.lockb"
  ]
}
